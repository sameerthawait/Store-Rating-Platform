{
  "name": "ratehub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RateHub - Production-ready Store Rating Platform Monorepo",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @ratehub/api --filter @ratehub/web dev",
    "dev:api": "pnpm --filter @ratehub/api start:dev",
    "dev:web": "pnpm --filter @ratehub/web dev",
    "build": "pnpm --filter @ratehub/shared build && pnpm --filter @ratehub/api build && pnpm --filter @ratehub/web build",
    "build:shared": "pnpm --filter @ratehub/shared build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,scss,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,scss,yaml,yml}\"",
    "test": "pnpm --recursive run test",
    "db:migrate": "pnpm --filter @ratehub/api prisma:migrate",
    "db:seed": "pnpm --filter @ratehub/api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
