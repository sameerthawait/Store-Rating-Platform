NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://[DATABASE_USER]:[DATABASE_PASSWORD]@localhost:5432/[DATABASE_NAME]?schema=public

# JWT Security (Must be distinct 32+ char random strings in production)
JWT_ACCESS_SECRET=[JWT_ACCESS_SECRET_MIN_32_CHARS]
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=[JWT_REFRESH_SECRET_MIN_32_CHARS]
JWT_REFRESH_EXPIRY=7d

# Password Hashing
BCRYPT_OR_ARGON2_COST=4

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Seed Admin Credentials (Provisioned on first database seed)
SEED_ADMIN_EMAIL=[SEED_ADMIN_EMAIL]
SEED_ADMIN_PASSWORD=[SEED_ADMIN_PASSWORD]
